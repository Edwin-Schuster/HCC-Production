# Copy to .env and edit before the first `docker compose up -d`.

# First admin account (only used when the database is empty)
ADMIN_USER=edwin
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=Edwin Schuster
ADMIN_EMAIL=

# Public address of the app, used in notification links and calendar events
APP_URL=https://production.example.org

# Load the sample SOPs, projects and gear on first start (true/false)
SEED_DEMO=true

# Set to true when served over HTTPS (recommended)
COOKIE_SECURE=true

# Largest upload in MB (videos for SOPs can be big)
MAX_UPLOAD_MB=500
