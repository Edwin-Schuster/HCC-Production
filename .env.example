# Required
POSTGRES_PASSWORD=change-me

# First start only: the first admin account. Without ADMIN_PASSWORD a random one is printed to the logs.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_EMAIL=

# Demo folders and SOPs on an empty database (true/false).
# Moving from the original app? Set false, then run the import (see README).
SEED_DEMO=true

# Public address of the app, used in links in phone notifications and the calendar feed
# APP_URL=https://production.example.org

# Set to true when served over HTTPS
COOKIE_SECURE=true

# Optional
# ORG_NAME=Hope Christian Church
# MAX_UPLOAD_MB=25
# Time zone for dates on the server-rendered pages and PDFs; applied at build time
# NEXT_PUBLIC_APP_TIMEZONE=America/Chicago
